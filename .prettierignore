# Add files here to ignore them from prettier formatting
.prettierignore
/dist
/coverage
/.nx/cache
/.nx/workspace-data
.nx/self-healing
# React Router writes its bundle to <app>/build and its route types to
# <app>/.react-router, both on every build. Formatting generated output
# just gets reverted by the next run.
**/build
**/.react-router
# Written by `nx release` for every package it versions. Its renderer emits
# two spaces after the breaking-change marker and before the commit link,
# and prettier collapses both to one, which makes the formatter a second
# producer of the file.
**/CHANGELOG.md
# The docs app's Next build cache and static export, rewritten on every
# `next build`.
apps/docs/.next
apps/docs/out
apps/docs/next-env.d.ts
# The docs build targets write their data here (`docs:benchmark-data` writes
# `benchmark-data.json`), and `apps/docs/.gitignore` keeps it out of git.
apps/docs/generated
# `docs:behaviour-data` writes the behaviour index and the highlighted cases
# here, and `apps/docs/.gitignore` keeps both out of git.
apps/docs/components/api/behaviour
apps/docs/public/behaviour
apps/docs/public/code-classes.css
apps/docs/public/popups
# Local agent ledgers. Each checkout excludes them from git in
# `.git/info/exclude`, so no commit carries them.
.superpowers
# Guard fixtures are data the docs guards read line by line, and their tests
# assert source line numbers. A fence prettier pads with a blank line moves
# every line after it.
tools/repo-checks/src/__fixtures__
# The 0.3 Docusaurus pages from 6d5e4f3 that the docs snapshot overlay copies
# over the originals (docs spec §15.2), and the 0.3 landing page, changed only
# in its logo path. Each copy differs from its original only by its
# corrections, and a format pass would rewrite the other lines.
apps/docs/snapshot/docs
apps/docs/snapshot/src
# Written by tools/generate-tokens.ts; src/tokens-generated.test.ts compares
# it byte for byte against the generator's own output, so prettier must not
# touch it.
internal/meridian-ui/src/tokens.generated.css
# The docs-e2e site assembled for each run, and the docs build it copies.
apps/docs-e2e/.site
apps/docs-e2e/.next-out
# The bridge API's graph, which `nx run @nexusdi/bridge-api:graph` writes
# with the nexusdi CLI and diffs against the committed copy. A format pass
# would make the formatter a second producer of the file.
examples/bridge-api/graph.json
# The library's goldens, which its e2e-growth tests write with JSON.stringify
# and compare byte for byte. Prettier folds a short array such as a shed list
# onto one line, so a format pass would fail the next run.
examples/meridian-systems/e2e/golden
# examples/next-bridge's Next build output and the file next build rewrites.
examples/next-bridge/.next
examples/next-bridge/next-env.d.ts
# Generated by `wrangler types` (Task 21); test-workers checks it is current.
examples/bridge-api/worker-configuration.d.ts
# `docs:scene-fixtures` writes the front page's fixtures here, and
# `apps/docs/.gitignore` keeps them out of git.
apps/docs/components/front-page/fixtures
# `ship_svg.py --cutaway-layers` writes the lights one entry to a line, and
# check-schematic compares the file with a fresh run, so a format pass would
# fail the next check.
apps/docs/components/ship-art/cutaway/meridian-cutaway-lights.json
