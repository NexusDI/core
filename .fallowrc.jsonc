{
  "$schema": "./node_modules/fallow/schema.json",

  // @nexusdi/core ships an API to consumers outside this repository. An
  // export or class member nothing in this workspace calls is the normal
  // state of a published entry point, not dead code -- only
  // scripts/verify-packaging.mjs and an external consumer's own code ever
  // reach it. This makes its exports and re-export surface reachability
  // roots, so they are not reported as unused.
  "publicPackages": ["@nexusdi/core"],

  // Nextra loads every page and `_meta.ts` under apps/docs/content by file
  // convention, never through an import, so the reachability walk reports
  // the whole content tree as unused without this.
  //
  // Every *.test-d.ts file under libs/core/src is vitest's own type-only
  // test file. fallow's vitest plugin derives entry points from
  // vite.config.ts's `test.include` glob (`src/**/*.{test,spec}.ts`), which
  // never matches `*.test-d.ts`; those files run through the separate
  // `test.typecheck.include` glob the plugin does not read. A glob here
  // covers every current and future one, so later tasks don't need to add
  // their own entry.
  "entry": [
    "apps/docs/content/**/*.{mdx,ts}",
    "libs/core/vite.decorators.ts",
    "libs/core/test-support/deferred.ts",
    "libs/core/src/**/*.test-d.ts",
  ],

  // `react-router typegen` writes +types/*.d.ts files that examples/react-ssr
  // reaches only through tsconfig.app.json's `rootDirs` (app merged with
  // .react-router/types/app at the same relative position) -- a TypeScript
  // compiler feature built specifically for this virtual-merge case, and
  // invisible to any resolver that isn't tsc itself. fallow's built-in
  // react-router plugin recognizes react-router.config.ts as an entry point
  // but does not implement rootDirs resolution (confirmed: even with typegen
  // freshly run and the real files present on disk, `+types/*` imports still
  // report unresolved -- fallow looks for them relative to the importing
  // file, never through the rootDirs remap). `nx run-many -t typegen` is
  // still run ahead of fallow in CI so the files exist for tsc, but this is
  // the actual fix for fallow's own resolution.
  "ignoreUnresolvedImports": ["**/+types/*"],

  // Guard fixtures: trees the docs guards read as data through computed
  // paths, and near-copies of each other by design.
  //
  // The Docusaurus overlay configs and the copied 0.3 landing page under
  // apps/docs/snapshot/ import `./docusaurus.config` and `@docusaurus/*`
  // modules that resolve only after `cp -R apps/docs/snapshot/.
  // snapshot-src/docs/` places them inside the 0.3 site (docs spec §15.2).
  // Nothing in this workspace can resolve those imports, so fallow would
  // report them as unused/unresolved. announcement.mjs is plain ESM with no
  // such import, so it stays analysed.
  "ignorePatterns": [
    "tools/repo-checks/src/__fixtures__/**",
    "apps/docs/snapshot/docusaurus.overlay.*.ts",
    "apps/docs/snapshot/src/**",
  ],

  // The docs guards under tools/repo-checks/src/docs import these names from
  // the shared site reader. `doc-fence` reads EXEMPTION_TAGS and SHELL_LANGS.
  // `doc-export-coverage`, `doc-twoslash`, `doc-regions` and `doc-commitments`
  // call parsePage. Most guards read CONTENT and readAllowance. proseOf joins
  // proseLines into one string for a prose guard. None of those guards exists
  // yet, so nothing imports the names today. Drop each name once a guard
  // imports it.
  "ignoreExports": [
    {
      "file": "tools/repo-checks/src/docs/paths.ts",
      "exports": ["CONTENT"],
    },
    {
      "file": "tools/repo-checks/src/docs/site.ts",
      "exports": ["EXEMPTION_TAGS", "SHELL_LANGS", "parsePage", "proseOf"],
    },
    {
      "file": "tools/repo-checks/src/docs/allowance.ts",
      "exports": ["readAllowance"],
    },
    // REQUIRED_PATHS is part of docs-trigger's documented interface (the
    // path filter checkTrigger checks docs.yml against), but checkTrigger
    // reads it itself and no caller needs it separately -- Task 42's live
    // run against .github/workflows/docs.yml imports only checkTrigger.
    // This entry does not go stale the way the block above does: no future
    // guard is expected to import it.
    {
      "file": "tools/repo-checks/src/docs/docs-trigger.ts",
      "exports": ["REQUIRED_PATHS"],
    },
    // readDeployConfig is part of deploy-config's documented interface. Its
    // one caller is the CLI block at the bottom of the same file, which
    // docs.yml runs as `node apps/docs/tools/deploy/deploy-config.mjs`. No
    // module imports it, and none is planned to.
    {
      "file": "apps/docs/tools/deploy/deploy-config.mjs",
      "exports": ["readDeployConfig"],
    },
  ],

  // Every workspace project's own eslint.config.mjs spreads a preset from
  // @nx/eslint-plugin (nx.configs['flat/base'|'flat/typescript'|'flat/javascript'|'flat/react']),
  // and those presets require these plugins by name internally
  // (node_modules/@nx/eslint-plugin/dist/src/flat-configs/*.js). Nothing in
  // this workspace imports them directly, so fallow's static import tracing
  // cannot see the consumer and reports them as unused.
  "ignoreDependencies": [
    "@swc-node/register",
    "@swc/helpers",
    "eslint-config-prettier",
    "eslint-plugin-import",
    "eslint-plugin-jsx-a11y",
    "eslint-plugin-react",
    "eslint-plugin-react-hooks",
    "jiti",
    "typescript-eslint",
    // Consumed by both the root eslint.config.mjs and
    // libs/core/eslint.config.mjs's `**/*.json` block
    // (languageOptions.parser), resolved through root-level hoisting. Not
    // duplicated into libs/core/package.json, which -- as a published
    // package -- carries no devDependencies at all (see libs/urn in the
    // libraries repo this tooling is modeled on).
    "jsonc-eslint-parser",
    // react-pair.test.ts imports tinyglobby directly, but nothing in this
    // workspace declares it: it is a transitive dependency of vite/vitest,
    // hoisted to the root. Mirrors the libraries repo's own entry for the
    // same import.
    "tinyglobby",
    // Imported by tools/doc-examples/src/vite-config.ts, which every
    // package's vite.config.ts pulls in through @nexusdi/doc-examples.
    // tools/doc-examples is private and carries no dependencies of its own
    // (see the libraries repo's tools/doc-examples, which this mirrors), so
    // it resolves through the root manifest instead.
    "vite-plugin-doctest",
  ],

  // 30 tokens rather than the default 50, mirroring the libraries repo this
  // tooling is modeled on: a handful of lines duplicated between two
  // decorators, or between two routes in the same app, is exactly the size
  // this is meant to catch. Config files are excluded because a per-project
  // vite or eslint config is meant to read the same as its neighbours.
  "duplicates": {
    "minTokens": 30,
    "minLines": 3,

    // Today's figure is 2.5%. The ceiling is a ratchet, not a target: it
    // fails the run that adds the next copy and is lowered whenever a clone
    // group is consolidated.
    "threshold": 2.6,

    "ignore": [
      "**/vite.config.*",
      "**/vitest.config.*",
      "**/eslint.config.*",
      "**/*.test-d.*",
      "**/*.test.*",
      "tools/repo-checks/src/__fixtures__/**",
    ],
  },
}
