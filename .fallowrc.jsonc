{
  "$schema": "./node_modules/fallow/schema.json",

  // @nexusdi/core ships an API to consumers outside this repository. An
  // export or class member nothing in this workspace calls is the normal
  // state of a published entry point, not dead code -- only
  // scripts/verify-packaging.mjs and an external consumer's own code ever
  // reach it. This makes its exports and re-export surface reachability
  // roots, so they are not reported as unused.
  // @nexusdi/meridian-ui is consumed by apps/docs through its built dist, and
  // visual-check.html renders every component. An export the docs app does not
  // import yet is still part of the design system.
  "publicPackages": [
    "@nexusdi/core",
    "@nexusdi/errors",
    "@nexusdi/testing",
    "@nexusdi/node",
    "@nexusdi/devtools",
    "@nexusdi/decorators",
    "@nexusdi/federation",
    "@nexusdi/interceptors",
    "@nexusdi/cli",
    "@nexusdi/express",
    "@nexusdi/fastify",
    "@nexusdi/hono",
    "@nexusdi/react-router",
    "@nexusdi/react",
    "@nexusdi/vitest",
    "@nexusdi/meridian-ui",
  ],

  // Core reads each class's `static deps` when it builds the class, so no
  // source file reads it outside the class.
  "usedClassMembers": ["deps"],

  // Nextra loads every page and `_meta.ts` under apps/docs/content by file
  // convention, never through an import, so the reachability walk reports
  // the whole content tree as unused without this.
  //
  // libs/decorators/vite.decorators.ts is imported by the decorators,
  // devtools, interceptors and meridian vite.config.ts files. fallow treats
  // a vite config as an entry point of its own and does not trace its
  // imports, so the file needs an entry.
  //
  // Each libs/*/test-support/nexus-request.ts has no importer. It augments
  // NexusRequest with `declare module`, and the package's tests reach it
  // through tsconfig.spec.json's `test-support/**` include, which fallow's
  // resolver does not read.
  //
  // Every *.test-d.ts file under libs/core/src is vitest's own type-only
  // test file. fallow's vitest plugin derives entry points from
  // vite.config.ts's `test.include` glob (`src/**/*.{test,spec}.ts`), which
  // never matches `*.test-d.ts`; those files run through the separate
  // `test.typecheck.include` glob the plugin does not read. A glob here
  // covers every current and future one.
  //
  // .github/workflows/release.yml runs the release scripts by path with
  // `node`, which no import reaches.
  "entry": [
    "apps/docs/content/**/*.{mdx,ts}",
    "tools/release/{plan,sync,reconcile,notes,stage}.mjs",
    // Run by hand from the gemma-docs skill.
    "tools/gemma-refactor.mjs",
    // The e2e project's webServer command runs serve.mjs by path.
    "apps/docs-e2e/src/support/serve.mjs",
    // The shell's Playwright suites: the e2e target runs
    // playwright.config.mts, and the e2e-growth target runs
    // playwright.e2e-growth.config.mts over e2e/growth. Both import the
    // servers playwright.servers.mts defines.
    "examples/federation-shell/e2e/**/*.ts",
    "examples/federation-shell/playwright.config.mts",
    "examples/federation-shell/playwright.e2e-growth.config.mts",
    // The docs app's behaviour-data target runs this script by path.
    "apps/docs/tools/behaviour-data.mjs",
    "libs/decorators/vite.decorators.ts",
    "libs/core/vitest.browser.config.ts",
    "libs/decorators/vitest.browser.config.ts",
    // The test-trace target of @nexusdi/devtools runs this config by path.
    "libs/devtools/vitest.trace.config.ts",
    "libs/core/test-support/nexus-request.ts",
    "libs/express/test-support/nexus-request.ts",
    "libs/fastify/test-support/nexus-request.ts",
    "libs/hono/test-support/nexus-request.ts",
    "libs/react-router/test-support/nexus-request.ts",
    // The e2e suite's fixture app: React Router loads its route modules,
    // root and entry by file convention, and vite.config.ts names the
    // fixture server as Vitest's globalSetup by path.
    "libs/react-router/test-fixtures/app/**/*.{ts,tsx}",
    "libs/react-router/test-support/fixture-server.ts",
    // @nexusdi/react's browser suites: a React Router 8 app the e2e test
    // builds, loaded by file convention, and a Vite app it serves under HMR
    // from index.html. vitest.e2e.config.ts runs them through the e2e target.
    "libs/react/test-fixtures/**/*.{ts,tsx}",
    "libs/react/vitest.e2e.config.ts",
    "libs/react/src/**/*.e2e.test.ts",
    // examples/next-bridge's gate suite, which its e2e target runs through
    // vitest.e2e.config.ts.
    "examples/next-bridge/e2e/**/*.ts",
    "examples/next-bridge/vitest.e2e.config.ts",
    // examples/bridge-api: the e2e suite and the benchmark its nx targets
    // run by path, the Node server entries a user starts, and the Workers
    // entry wrangler bundles (Task 21).
    "examples/bridge-api/e2e/**/*.ts",
    "examples/bridge-api/vitest.e2e.config.ts",
    "examples/bridge-api/vitest.e2e-growth.config.ts",
    "examples/bridge-api/vitest.workers.config.ts",
    "examples/bridge-api/vitest.workers-growth.config.ts",
    // The Deno, Bun and Edge Runtime legs: runtime-leg.mjs runs by path and
    // bundles smoke.ts, or growth.ts for e2e-growth, and the edge test
    // bundles entry.ts by path.
    "examples/bridge-api/vitest.edge.config.ts",
    "examples/bridge-api/scripts/runtime-leg.mjs",
    "examples/bridge-api/test/runtime/smoke.ts",
    "examples/bridge-api/test/runtime/growth.ts",
    "examples/bridge-api/test/edge/entry.ts",
    "examples/bridge-api/bench/*.{ts,mjs}",
    "examples/bridge-api/src/entries/server.*.ts",
    "examples/bridge-api/src/entries/worker.ts",
    // examples/meridian-systems: the e2e-growth target runs the idle golden
    // by path, and the golden is read by the snapshot matcher, never imported.
    "examples/meridian-systems/e2e/**/*.ts",
    "examples/meridian-systems/vitest.e2e-growth.config.ts",
    "examples/meridian-systems/e2e/golden/*.json",
    // examples/bridge-console's Playwright suites: the e2e target runs
    // playwright.config.mts, and the e2e-growth target runs
    // playwright.e2e-growth.config.mts over e2e/growth.
    "examples/bridge-console/e2e/**/*.ts",
    "examples/bridge-console/playwright.config.mts",
    "examples/bridge-console/playwright.e2e-growth.config.mts",
    "libs/vitest/test-support/nexus-request.ts",
    "libs/core/src/**/*.test-d.ts",
    "libs/errors/src/**/*.test-d.ts",
    "libs/testing/src/**/*.test-d.ts",
    "libs/node/src/**/*.test-d.ts",
    "libs/devtools/src/**/*.test-d.ts",
    "libs/decorators/src/**/*.test-d.ts",
    "libs/federation/src/**/*.test-d.ts",
    "libs/interceptors/src/**/*.test-d.ts",
    "libs/express/src/**/*.test-d.ts",
    "libs/fastify/src/**/*.test-d.ts",
    "libs/hono/src/**/*.test-d.ts",
    "libs/react-router/src/**/*.test-d.ts",
    "libs/react/src/**/*.test-d.{ts,tsx}",
    "libs/vitest/src/**/*.test-d.ts",
    "libs/vitest/src/__fixtures__/**",
    // fallow's vitest plugin derives entry points from vite.config.ts's
    // test.include glob alone. Each vitest.browser.config.ts, the Chromium
    // project that runs R20, is a separate config file the plugin never
    // reads, so its *.browser.test.ts files need their own entry.
    "libs/core/src/**/*.browser.test.ts",
    "libs/decorators/src/**/*.browser.test.ts",
    // The bin is the cli package's entry point, named by package.json's bin;
    // the fixtures are imported by the spawned bin, never by a static import.
    "libs/cli/src/bin.ts",
    "libs/cli/test-fixtures/**",
    // The README graph: the nexusdi bin imports the fixture app by path,
    // and the generate target runs generate.ts by path.
    "tools/readme-assets/src/meridian.module.ts",
    "tools/readme-assets/src/generate.ts",

    // internal/meridian-ui's generate-tokens nx target runs this by path
    // through jiti, not by import. It writes tokens.generated.css, which no
    // import reaches it either: styles.css imports it with a CSS @import,
    // which fallow does not trace, and tokens-generated.test.ts reads it by path to compare it against
    // renderTokensCss().
    "internal/meridian-ui/tools/generate-tokens.ts",
    "internal/meridian-ui/src/tokens.generated.css",
    // Every *.test-d.tsx file under internal/meridian-ui/src is vitest's
    // type-only test file, like the libs entries above but in .tsx format.
    "internal/meridian-ui/src/**/*.test-d.tsx",

    // Built and run by examples/toolchain-matrix/scripts/run-matrix.mjs in a
    // throwaway consumer; nothing in the workspace imports them. The vite
    // configs are passed to vite by --config, a CLI argument fallow's
    // static resolver does not follow, so they need the same entry.
    "examples/toolchain-matrix/src/*/main.ts",
    "examples/toolchain-matrix/scripts/*.mjs",
    "examples/toolchain-matrix/vite.matrix.config.mjs",
    "examples/toolchain-matrix/vite.babel.config.mjs",

    // Run by `npm run check:type-floor` (package.json), not imported by
    // anything in the workspace.
    "scripts/check-type-floor.mjs",

    // scripts/size-report.mjs runs from `npm run size` and bundles each
    // examples/size fixture by path through esbuild. The size workflow runs
    // scripts/size-compare.mjs by path. Nothing imports any of them.
    "scripts/size-report.mjs",
    "scripts/size-compare.mjs",
    "examples/size/src/*.ts",

    // The benchmark harness. The fixtures and scenario.mjs are copied into a
    // throwaway consumer and built there; the profile configs reach the
    // toolchains through CLI flags; the src/*.ts writers and core's
    // dispatch benchmark run by path from nx targets. Nothing imports them.
    "benchmarks/fixtures/**/*.{ts,mjs}",
    "benchmarks/src/{matrix,probes,size,build,competitor-releases,release-core,open-results-pr}.ts",
    "benchmarks/src/timings/{orchestrator.ts,worker.mjs,cold-child.mjs}",
    "benchmarks/src/scale/{verify-child,child,worker}.mjs",
    // The scale timing orchestrator runs from the scale-timings nx target and
    // the check target; no workflow runs it until the budget follow-up.
    "benchmarks/src/scale/timings.ts",
    // The check target runs the *.cell.test.ts files through
    // vitest.cells.config.ts, a config the vitest plugin never reads.
    "benchmarks/vitest.cells.config.ts",
    "benchmarks/src/**/*.cell.test.ts",
    "libs/core/bench/*.mjs",
  ],

  // `react-router typegen` writes +types/*.d.ts files that examples/bridge-console
  // reaches only through tsconfig.app.json's `rootDirs` (app merged with
  // .react-router/types/app at the same relative position) -- a TypeScript
  // compiler feature built specifically for this virtual-merge case, and
  // invisible to any resolver that isn't tsc itself. fallow's built-in
  // react-router plugin recognizes react-router.config.ts as an entry point
  // but does not implement rootDirs resolution (confirmed: even with typegen
  // freshly run and the real files present on disk, `+types/*` imports still
  // report unresolved -- fallow looks for them relative to the importing
  // file, never through the rootDirs remap). `nx run-many -t typegen` is
  // still run ahead of fallow in CI so the files exist for tsc, but this is
  // the actual fix for fallow's own resolution.
  //
  // These imports name files a build step writes and git ignores, so a clean
  // checkout lacks them. benchmark-data.json comes from the docs
  // benchmark-data target. styles.css comes from the meridian-ui build, which
  // the docs import through the package export @nexusdi/meridian-ui/styles.css.
  "ignoreUnresolvedImports": [
    "**/+types/*",
    "**/generated/benchmark-data.json",
    "**/dist/styles.css",
    "@nexusdi/meridian-ui/styles.css",
  ],

  // Guard fixtures: trees the docs guards read as data through computed
  // paths, and near-copies of each other by design.
  //
  // The Docusaurus overlay configs and the copied 0.3 landing page under
  // apps/docs/snapshot/ import `./docusaurus.config` and `@docusaurus/*`
  // modules that resolve only after `cp -R apps/docs/snapshot/.
  // snapshot-src/docs/` places them inside the 0.3 site (docs spec §15.2).
  // Nothing in this workspace can resolve those imports, so fallow would
  // report them as unused/unresolved. announcement.mjs is plain ESM with no
  // such import, so it stays analysed.
  "ignorePatterns": [
    "tools/repo-checks/src/__fixtures__/**",
    // `wrangler types` writes the Workers runtime and env types here, and the
    // bridge API's test-workers target checks the file is current.
    "examples/bridge-api/worker-configuration.d.ts",
    "apps/docs/snapshot/docusaurus.overlay.*.ts",
    "apps/docs/snapshot/src/**",
  ],

  // The docs guards under tools/repo-checks/src/docs import these names from
  // the shared site reader. `doc-fence` reads EXEMPTION_TAGS and SHELL_LANGS.
  // `doc-export-coverage`, `doc-twoslash`, `doc-regions` and `doc-commitments`
  // call parsePage. Most guards read CONTENT and readAllowance. proseOf joins
  // proseLines into one string for a prose guard. None of those guards exists
  // yet, so nothing imports the names today. Drop each name once a guard
  // imports it.
  "ignoreExports": [
    // The default export of each is the Turbopack loader. next.config.ts
    // reaches it by file path through tools/loader-chain.mjs, which no
    // import edge shows to fallow.
    {
      "file": "apps/docs/tools/mdx-diagram-loader.mjs",
      "exports": ["default"],
    },
    {
      "file": "apps/docs/tools/mdx-listing-loader.mjs",
      "exports": ["default"],
    },
    {
      "file": "tools/repo-checks/src/docs/paths.ts",
      "exports": ["CONTENT"],
    },
    {
      "file": "tools/repo-checks/src/docs/site.ts",
      "exports": ["EXEMPTION_TAGS", "SHELL_LANGS", "parsePage", "proseOf"],
    },
    {
      "file": "tools/repo-checks/src/docs/allowance.ts",
      "exports": ["readAllowance"],
    },
    // REQUIRED_PATHS is part of docs-trigger's documented interface (the
    // path filter checkTrigger checks docs.yml against), but checkTrigger
    // reads it itself and no caller needs it separately. The live check
    // against .github/workflows/docs.yml imports only checkTrigger.
    // This entry does not go stale the way the block above does: no future
    // guard is expected to import it.
    {
      "file": "tools/repo-checks/src/docs/docs-trigger.ts",
      "exports": ["REQUIRED_PATHS"],
    },
    // readDeployConfig is part of deploy-config's documented interface. Its
    // one caller is the CLI block at the bottom of the same file, which
    // docs.yml runs as `node apps/docs/tools/deploy/deploy-config.mjs`. No
    // module imports it, and none is planned to.
    {
      "file": "apps/docs/tools/deploy/deploy-config.mjs",
      "exports": ["readDeployConfig"],
    },
    // DOCS_YML_PATHS is the copy of docs.yml's push paths that docs-ci-job's
    // test compares with docs.yml. It loads the module through a computed
    // dynamic import, which fallow does not follow.
    // graphPlugins is the array `nexusdi graph --plugins
    // src/ship/plugins.ts#graphPlugins` reads by name, in the bridge API's
    // graph target. No module imports it.
    // The bridge console's route tests' vi.mock factories call these through
    // a dynamic import of the module, which fallow does not follow to a
    // member.
    {
      "file": "examples/bridge-console/tests/support/testing-di.ts",
      "exports": ["homeServer", "courseServer", "sectorsServer"],
    },
    {
      "file": "examples/bridge-api/src/ship/plugins.ts",
      "exports": ["graphPlugins"],
    },
    {
      "file": "apps/docs/tools/deploy/docs-changed.mjs",
      "exports": ["DOCS_YML_PATHS"],
    },
  ],

  // Every workspace project's own eslint.config.mjs spreads a preset from
  // @nx/eslint-plugin (nx.configs['flat/base'|'flat/typescript'|'flat/javascript'|'flat/react']),
  // and those presets require these plugins by name internally
  // (node_modules/@nx/eslint-plugin/dist/src/flat-configs/*.js). Nothing in
  // this workspace imports them directly, so fallow's static import tracing
  // cannot see the consumer and reports them as unused.
  "ignoreDependencies": [
    // apps/docs/app/layout.tsx hands next/font/local relative paths into
    // node_modules for the woff2 files. No import statement names these
    // packages, so fallow reports them as unused.
    "@fontsource-variable/space-grotesk",
    "@fontsource/ibm-plex-mono",
    "@fontsource/ibm-plex-sans",
    // examples/meridian lists every package its example blocks import. The
    // blocks live in .md files under src/, which fallow does not read, so
    // these report as unused there.
    "@hono/node-server",
    // Every libs/*/vite.config.ts imports the doc-example plugin. The libs
    // do not list the private tools/doc-examples workspace in their
    // package.json, because their published manifests should not name it.
    "@nexusdi/doc-examples",
    "@nexusdi/express",
    "@nexusdi/fastify",
    "@nexusdi/federation",
    "@nexusdi/hono",
    "@nexusdi/interceptors",
    "@nexusdi/node",
    "@nexusdi/react",
    "@nexusdi/vitest",
    "express",
    "fastify",
    "hono",
    "react",
    "react-dom",
    "react-router",
    "valibot",
    // Optional peers of @nexusdi/cli. The cli's image tests spawn the built
    // bin, which resolves them by path from the user's project
    // (libs/cli/src/resolve.ts), so no import statement names either one.
    "@viz-js/viz",
    "@resvg/resvg-js",
    // tools/readme-assets runs the nexusdi bin it reads from
    // @nexusdi/cli's package.json, so no import statement names the cli.
    "@nexusdi/cli",
    // examples/federation-shell's growth suite runs bridge-api's Hono entry
    // by path (playwright.servers.mts). The devDependency makes the
    // e2e-growth target's ^build build it, and no import statement names it.
    "@nexusdi/bridge-api",
    "@swc-node/register",
    "@swc/helpers",
    "eslint-config-prettier",
    "eslint-plugin-import",
    "eslint-plugin-jsx-a11y",
    "eslint-plugin-react",
    "eslint-plugin-react-hooks",
    "jiti",
    // apps/docs/tools/pagefind.mjs runs the pagefind CLI through
    // `npx pagefind`, which fallow's import tracing cannot see.
    "pagefind",
    // benchmarks/src/consumer.ts tslibVersion() reads the pin from
    // benchmarks/package.json at runtime, and every scale cell installs it, so no
    // import statement names it.
    "tslib",
    "typescript-eslint",
    // Consumed by both the root eslint.config.mjs and
    // libs/core/eslint.config.mjs's `**/*.json` block
    // (languageOptions.parser), resolved through root-level hoisting. Not
    // duplicated into libs/core/package.json, which -- as a published
    // package -- carries no devDependencies at all (see libs/urn in the
    // libraries repo this tooling is modeled on).
    "jsonc-eslint-parser",
    // Imported by the core and decorators vitest.browser.config.ts files,
    // the Chromium projects that run R20. Declared in the root package.json,
    // hoisted from there; not duplicated into either package.json, which --
    // as a published package -- carries no devDependencies at all.
    "@vitest/browser-playwright",
    // Imported by libs/devtools/src/profile/trace-engine.trace.test.ts, the
    // test-trace target's golden test of the Chrome layout. Declared in the
    // root package.json with an exact pin; not duplicated into
    // libs/devtools/package.json, which as a published package carries no
    // devDependencies.
    "@paulirish/trace_engine",
    // react-pair.test.ts imports tinyglobby directly, but nothing in this
    // workspace declares it: it is a transitive dependency of vite/vitest,
    // hoisted to the root. Mirrors the libraries repo's own entry for the
    // same import.
    "tinyglobby",
    // Imported by tools/doc-examples/src/vite-config.ts, which every
    // package's vite.config.ts pulls in through @nexusdi/doc-examples.
    // tools/doc-examples is private and carries no dependencies of its own
    // (see the libraries repo's tools/doc-examples, which this mirrors), so
    // it resolves through the root manifest instead.
    "vite-plugin-doctest",
    // Imported by tools/doc-examples/src/module-fences.ts, for the same
    // reason: tools/doc-examples carries no dependencies of its own.
    "ts-blank-space",
    // Imported by tools/doc-examples/src/lower-doctests.ts, for the same
    // reason. Its output imports @oxc-project/runtime's helpers, which no
    // source file names.
    "oxc-transform",
    "@oxc-project/runtime",
    // examples/toolchain-matrix/src/*.ts import @nexusdi/core,
    // @nexusdi/decorators and @nexusdi/devtools, and vite.babel.config.mjs
    // imports @rolldown/plugin-babel, but none belongs in the project's
    // package.json: run-matrix.mjs installs the packed tarballs and every
    // pinned toolchain package into a throwaway consumer it builds in, never
    // into this workspace project (see toolchains.json). The project's
    // package.json declares no dependencies. libs/devtools's R04 test imports
    // @nexusdi/decorators too; the workspace links it, and
    // libs/devtools/package.json, as a published package, carries no
    // devDependencies.
    "@nexusdi/core",
    "@nexusdi/decorators",
    "@nexusdi/devtools",
    "@rolldown/plugin-babel",
    // libs/errors/src/parity/messages.test.ts imports @nexusdi/testing to
    // pin the text errors() writes for a malformed override. The workspace
    // links the package, and libs/errors/package.json, as a published
    // package, carries no devDependencies.
    "@nexusdi/testing",
    // libs/federation/src/text.test.ts and the federation README's doctest
    // import @nexusdi/errors to format a contract mismatch through
    // federationText, and libs/interceptors' tests and README doctest import
    // it to format interceptor errors through interceptorsText. The workspace
    // links the package, and libs/federation/package.json and
    // libs/interceptors/package.json, as published packages, carry no
    // devDependencies.
    "@nexusdi/errors",
    // libs/react/test-fixtures/rr8 imports @nexusdi/react-router, linked by
    // the workspace. The fixture is the app a user writes, and the package
    // itself needs nothing from the adapter.
    "@nexusdi/react-router",
    // The competitor libraries and their polyfill, which the benchmark
    // fixtures import. benchmarks/src/consumer.ts installs the pins from
    // benchmarks/libraries.json into the throwaway consumer the fixtures
    // build in, never into the workspace.
    "@needle-di/core",
    "awilix",
    "inversify",
    "reflect-metadata",
    "tsyringe",
    // libs/core/bench/build.mjs bundles core with esbuild from the root
    // manifest. libs/core/package.json, as a published package, carries no
    // devDependencies.
    "esbuild",
    // libs/core/bench/run.mjs and worker.mjs import the shared benchmark
    // harness from tools/bench-kit (benchmarks/package.json already declares
    // it as a devDependency for its own imports). libs/core/package.json, as
    // a published package, carries no devDependencies, and bench-kit is
    // private and never published, so it cannot go there either way.
    "@nexusdi/bench-kit",
    // internal/meridian-ui/eslint.config.mjs imports @nx/eslint-plugin and
    // internal/meridian-ui/vite.config.ts imports vite-plugin-dts. The
    // workspace links both from the root manifest, and
    // internal/meridian-ui/package.json declares only the dependencies it
    // needs at runtime and in its tests (@testing-library/react), not these.
    "@nx/eslint-plugin",
    "vite-plugin-dts",
  ],

  // definitions/standard-schema.ts declares `StandardSchemaV1` twice on
  // purpose -- an interface and a `declare namespace` of the same name,
  // which TypeScript merges into one symbol (`StandardSchemaV1.Props`,
  // `StandardSchemaV1.InferOutput`, ...). This is the Standard Schema spec's
  // own published shape, copied verbatim so core takes no dependency on it.
  // fallow's duplicate-export check does not model declaration merging, so
  // it reports the file's two `export` statements as a duplicate-export
  // group of one file against itself. `ignoreFindings` hides the finding
  // without excluding the file from analysis or resolution.
  "ignoreFindings": ["libs/core/src/definitions/standard-schema.ts"],

  // 30 tokens rather than the default 50, mirroring the libraries repo this
  // tooling is modeled on: a handful of lines duplicated between two
  // decorators, or between two routes in the same app, is exactly the size
  // this is meant to catch. Config files are excluded because a per-project
  // vite, rspack or eslint config is meant to read the same as its neighbours.
  "duplicates": {
    "minTokens": 30,
    "minLines": 3,

    // The figure on 2026-10-24 is 1.91%. The ceiling is a ratchet. It fails
    // the run that adds the next copy, and each consolidated clone group
    // lowers it.
    //
    // Raised from 1.95 on 2026-10-28: fallow 3.34 measures the same code at
    // 2.06%. Lower it again after the demo refactor
    // (specs/plans/2026-10-28-demo-refactor.md).
    "threshold": 2.1,

    "ignore": [
      "**/vite.config.*",
      "**/vitest.config.*",
      "**/vitest.browser.config.*",
      "**/eslint.config.*",
      "**/rspack.config*",
      "**/*.test-d.*",
      "**/*.test.*",
      // Core's error fixtures, one case per code, and the full set
      // @nexusdi/errors snapshots the text of. Each package's tests reach
      // only their own test-support and core's package entry, so the two
      // files cannot share one module.
      "libs/*/test-support/error-cases.ts",
      // moduleChain, the deep chain core's SEC-009 and devtools' SEC-010
      // compile. Each package's tests reach only their own test-support, so
      // the two copies cannot share one module.
      "libs/*/test-support/security.ts",
      // The server adapters' shared request scope, P4's named exception
      // (integrations spec 3.7, ruling V13). adapter-shared-copies.test.ts
      // keeps the copies byte-identical.
      "libs/*/src/internal/request-scope.ts",
      // The body wrapper of integrations spec 3.4, one byte-identical copy
      // per adapter that returns its Response before the body is written
      // (Hono, React Router). P4's named exception (ruling V13);
      // adapter-shared-copies.test.ts holds the copies equal.
      "libs/*/src/internal/dispose-with-body.ts",
      // The dense visibility pass, kept as the oracle the sparse pass in
      // libs/core/src/blueprint/visibility.ts is tested against.
      "libs/core/test-support/visibility-oracle.ts",
      "tools/repo-checks/src/__fixtures__/**",
      // The adapters' fixture apps: each is a self-contained consumer a
      // browser or e2e suite builds, written the way an application writes
      // its entry files and route modules, so they repeat React Router's
      // default entries and each other by design.
      "libs/*/test-fixtures/**",
      // Meridian-8 once per library and variant: each fixture is one
      // self-contained file a toolchain builds alone (benchmarks spec 4.1),
      // and the profile configs differ in one or two keys each.
      "benchmarks/fixtures/**",
      // One renderer per library, each following that library's documented
      // idiom for the same graph (scale spec 4.2). A reviewer reads each beside
      // its docs page (CONTRIBUTING.md, Benchmarks), so the parallel shape is
      // kept apart per library, and what is identical lives in render/shared.ts.
      "benchmarks/src/scale/render/*.ts",
      // The bridge API wires the same routes once per framework, so each
      // server entry reads beside that framework's guide.
      "examples/bridge-api/src/entries/{express,fastify,hono}.ts",
      // The mission and flight log every adapter example and fixture
      // defines in its own self-contained app: the Next gate's graph and the
      // bridge API's MissionScope module.
      "examples/next-bridge/app/ship/gate.module.ts",
      "examples/bridge-api/src/ship/mission-scope.module.ts",
    ],
  },
}
