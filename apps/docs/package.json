{
  "name": "@nexusdi/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "postbuild": "node tools/md-siblings.mjs && node tools/blog-feed.mjs && node tools/pagefind.mjs"
  },
  "nx": {
    "tags": [
      "scope:docs",
      "type:app"
    ],
    "targets": {
      "benchmark-data": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "{projectRoot}",
          "command": "node tools/benchmark-data.mjs"
        }
      },
      "behaviour-data": {
        "command": "node tools/behaviour-data.mjs",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "{projectRoot}/tools/behaviour-data.mjs",
          "{projectRoot}/tools/code-classes.mjs",
          "{projectRoot}/tools/libraries.mjs",
          "{projectRoot}/tools/sidecars.mjs",
          "{workspaceRoot}/tools/doc-examples/src/*.mjs",
          "{workspaceRoot}/libs/*/package.json",
          "{workspaceRoot}/libs/*/src/**/*.ts",
          "{workspaceRoot}/libs/*/src/**/*.tsx",
          "{workspaceRoot}/tsconfig.base.json",
          {
            "externalDependencies": [
              "shiki",
              "@shikijs/themes",
              "@shikijs/transformers",
              "@shikijs/twoslash",
              "twoslash",
              "typescript"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/components/api/behaviour",
          "{projectRoot}/public/behaviour",
          "{projectRoot}/public/code-classes.css"
        ]
      },
      "scene-fixtures": {
        "command": "node --experimental-strip-types tools/scene-fixtures.mjs",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "{projectRoot}/tools/scene-fixtures.mjs",
          "{workspaceRoot}/examples/meridian/src/scenes/*.ts",
          "{workspaceRoot}/examples/meridian/package.json",
          "{workspaceRoot}/libs/*/package.json",
          "{workspaceRoot}/libs/*/src/**/*.ts",
          "{workspaceRoot}/tsconfig.base.json"
        ],
        "outputs": [
          "{projectRoot}/components/front-page/fixtures"
        ]
      },
      "build": {
        "dependsOn": [
          "^build",
          "benchmark-data",
          "behaviour-data",
          "scene-fixtures",
          {
            "projects": [
              "@nexusdi/meridian"
            ],
            "target": "typecheck"
          }
        ],
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/examples/meridian/src/**/*",
          {
            "dependentTasksOutputFiles": "**/*"
          },
          {
            "env": "DOCS_BASE_PATH"
          },
          {
            "env": "DOCS_CHANNEL"
          }
        ],
        "outputs": [
          "{projectRoot}/out"
        ]
      },
      "check-budgets": {
        "command": "node tools/check-budgets.mjs",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ]
      },
      "typecheck": {
        "cache": true,
        "dependsOn": [
          "^build",
          "benchmark-data",
          "behaviour-data",
          "scene-fixtures",
          {
            "projects": [
              "@nexusdi/meridian"
            ],
            "target": "typecheck"
          }
        ],
        "inputs": [
          "default",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "command": "tsc --project tsconfig.json",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "test": {
        "dependsOn": [
          "^build",
          "benchmark-data",
          "behaviour-data",
          "scene-fixtures"
        ],
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/examples/meridian-systems/deck/meridian.geometry.json"
        ]
      }
    }
  },
  "dependencies": {
    "@nexusdi/doc-examples": "*",
    "@nexusdi/meridian-deck": "*",
    "@nexusdi/meridian-ui": "*",
    "mermaid": "^12.2.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "@nexusdi/core": "*",
    "@nexusdi/decorators": "*",
    "@nexusdi/devtools": "*",
    "@nexusdi/errors": "*",
    "@nexusdi/express": "*",
    "@nexusdi/fastify": "*",
    "@nexusdi/federation": "*",
    "@nexusdi/hono": "*",
    "@nexusdi/interceptors": "*",
    "@nexusdi/meridian": "*",
    "@nexusdi/node": "*",
    "@nexusdi/react": "*",
    "@nexusdi/react-router": "*",
    "@nexusdi/testing": "*",
    "@nexusdi/vitest": "*",
    "@nx/eslint-plugin": "23.3.0",
    "@shikijs/themes": "4.5.0",
    "@shikijs/transformers": "4.5.0",
    "@shikijs/twoslash": "4.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "eslint-config-next": "16.4.3",
    "hast-util-sanitize": "5.0.2",
    "pagefind": "^1.5.2",
    "sharp": "0.35.5",
    "shiki": "4.5.0",
    "tailwindcss": "^4.3.3",
    "twoslash": "0.3.9",
    "typescript": "6.0.3",
    "yaml": "^2.9.1"
  }
}
