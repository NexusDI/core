{
  "name": "@nexusdi/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "postbuild": "node tools/md-siblings.mjs && node tools/blog-feed.mjs && node tools/pagefind.mjs"
  },
  "nx": {
    "tags": [
      "scope:docs",
      "type:app"
    ],
    "targets": {
      "benchmark-data": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "{projectRoot}",
          "command": "node tools/benchmark-data.mjs"
        }
      },
      "build": {
        "dependsOn": [
          "^build",
          "benchmark-data"
        ],
        "inputs": [
          "default",
          "^production",
          {
            "env": "DOCS_BASE_PATH"
          },
          {
            "env": "DOCS_CHANNEL"
          }
        ],
        "outputs": [
          "{projectRoot}/.next",
          "{projectRoot}/out"
        ]
      },
      "check-budgets": {
        "command": "node tools/check-budgets.mjs",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ]
      },
      "typecheck": {
        "cache": true,
        "dependsOn": [
          "^build",
          "benchmark-data"
        ],
        "inputs": [
          "default",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "command": "tsc --project tsconfig.json",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@nexusdi/doc-examples": "*",
    "@nexusdi/meridian-ui": "*",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "23.1.1",
    "@testing-library/react": "16.3.0",
    "eslint-config-next": "16.3.4",
    "pagefind": "^1.5.2",
    "typescript": "6.0.3",
    "yaml": "^2.9.0"
  }
}
