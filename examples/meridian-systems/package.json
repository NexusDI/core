{
  "name": "@nexusdi/meridian-systems",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./text": {
      "types": "./src/text.ts",
      "import": "./src/text.ts",
      "default": "./src/text.ts"
    },
    "./interlock": {
      "types": "./src/systems/safety/pressure-interlock.ts",
      "import": "./src/systems/safety/pressure-interlock.ts",
      "default": "./src/systems/safety/pressure-interlock.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@nexusdi/core": "*"
  },
  "peerDependencies": {
    "@nexusdi/interceptors": "*"
  },
  "peerDependenciesMeta": {
    "@nexusdi/interceptors": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nexusdi/devtools": "*",
    "@nexusdi/errors": "*",
    "@nexusdi/interceptors": "*",
    "@nexusdi/vitest": "*"
  },
  "nx": {
    "tags": [
      "demo"
    ],
    "targets": {
      "e2e-growth": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "options": {
          "cwd": "examples/meridian-systems",
          "command": "vitest run --config vitest.e2e-growth.config.ts"
        }
      }
    }
  }
}
