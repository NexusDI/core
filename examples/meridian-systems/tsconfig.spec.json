{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "types": ["vitest/importMeta", "node", "vitest"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["es2022", "esnext.disposable"],
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "vitest.config.mts",
    "vitest.e2e-growth.config.ts",
    "e2e/**/*.ts",
    "src/**/*.test.ts",
    "src/**/*.d.ts",
    "src/**/__fixtures__/*.json",
    "test/**/*.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "../../libs/core/tsconfig.lib.json"
    },
    {
      "path": "../../libs/errors/tsconfig.lib.json"
    },
    {
      "path": "../../libs/vitest/tsconfig.lib.json"
    },
    {
      "path": "../../libs/testing/tsconfig.lib.json"
    },
    {
      "path": "../../libs/devtools/tsconfig.lib.json"
    }
  ]
}
