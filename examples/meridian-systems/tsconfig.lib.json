{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    // Vitest and the apps run the sources, so they resolve as a bundler
    // does: extensionless imports and a JSON module.
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["es2022", "esnext.disposable"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "deck/*.json"],
  "references": [
    {
      "path": "../../libs/vitest/tsconfig.lib.json"
    },
    {
      "path": "../../libs/testing/tsconfig.lib.json"
    },
    {
      "path": "../../libs/errors/tsconfig.lib.json"
    },
    {
      "path": "../../tools/doc-examples"
    },
    {
      "path": "../../libs/devtools/tsconfig.lib.json"
    },
    {
      "path": "../../libs/interceptors/tsconfig.lib.json"
    },
    {
      "path": "../../libs/core/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
