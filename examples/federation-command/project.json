{
  "name": "@nexusdi/federation-command",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "examples/federation-command/src",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "rspack serve --mode=development",
        "cwd": "examples/federation-command"
      },
      "dependsOn": ["^build", "@nexusdi/federation-shell:serve"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rspack build --mode=production",
        "cwd": "examples/federation-command"
      },
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist/main"]
    }
  }
}
