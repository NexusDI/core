{
  "name": "@nexusdi/federation-contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nexusdi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./version": {
      "@nexusdi/source": "./src/version.ts",
      "types": "./dist/version.d.ts",
      "import": "./dist/version.js",
      "default": "./dist/version.js"
    },
    "./shared": {
      "@nexusdi/source": "./src/shared.ts",
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.js",
      "default": "./dist/shared.js"
    },
    "./swc": {
      "@nexusdi/source": "./src/swc.ts",
      "types": "./dist/swc.d.ts",
      "import": "./dist/swc.js",
      "default": "./dist/swc.js"
    },
    "./rspack": {
      "@nexusdi/source": "./src/rspack.ts",
      "types": "./dist/rspack.d.ts",
      "import": "./dist/rspack.js",
      "default": "./dist/rspack.js"
    },
    "./testing": {
      "@nexusdi/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "dependencies": {
    "@module-federation/enhanced": "2.9.2",
    "@nexusdi/core": "*",
    "@nexusdi/federation": "*",
    "@rspack/core": "2.2.9",
    "@rspack/plugin-react-refresh": "2.0.2",
    "react": "19.3.1",
    "react-refresh": "0.19.0"
  },
  "devDependencies": {
    "@nexusdi/errors": "*"
  },
  "nx": {
    "tags": [
      "demo-frontend"
    ],
    "targets": {
      "test": {
        "dependsOn": [
          "build",
          "^build"
        ]
      }
    }
  }
}
