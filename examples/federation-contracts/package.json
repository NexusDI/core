{
  "name": "@nexusdi/federation-contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nexusdi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./version": {
      "@nexusdi/source": "./src/version.ts",
      "types": "./dist/version.d.ts",
      "import": "./dist/version.js",
      "default": "./dist/version.js"
    },
    "./shared": {
      "@nexusdi/source": "./src/shared.ts",
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.js",
      "default": "./dist/shared.js"
    }
  },
  "dependencies": {
    "@nexusdi/core": "*",
    "@nexusdi/federation": "*",
    "react": "19.3.1"
  },
  "nx": {
    "tags": [
      "demo-frontend"
    ],
    "targets": {
      "test": {
        "dependsOn": [
          "build",
          "^build"
        ]
      }
    }
  }
}
