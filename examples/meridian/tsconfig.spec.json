{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest"
    ],
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "lib": ["es2022", "esnext.decorators", "esnext.disposable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "ignoreDeprecations": "6.0",
    "rootDir": "."
  },
  "include": ["vite.config.ts", "src/**/*.ts", "src/**/*.d.ts"],
  // The library project owns the scene; the tests reach it through the reference.
  "exclude": ["src/scenes/front-page.ts"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "../../libs/decorators/tsconfig.spec.json"
    }
  ]
}
