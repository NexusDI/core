{
  "name": "@nexusdi/federation-shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "examples/federation-shell/src",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "rspack serve --mode=development",
        "cwd": "examples/federation-shell"
      },
      "dependsOn": ["^build"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rspack build --mode=production",
        "cwd": "examples/federation-shell"
      },
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist/main"],
      "cache": true,
      "inputs": ["production", "^production"]
    },
    "build-e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist/e2e"],
      "options": {
        "command": "rspack build --mode=production --env devtools",
        "cwd": "examples/federation-shell"
      }
    },
    "e2e": {
      "dependsOn": [
        "build-e2e",
        {
          "projects": ["@nexusdi/federation-cartography"],
          "target": "build"
        },
        {
          "projects": ["@nexusdi/federation-cartography"],
          "target": "build-drift"
        },
        {
          "projects": ["@nexusdi/federation-cartography"],
          "target": "build-unshared"
        },
        {
          "projects": ["@nexusdi/federation-command"],
          "target": "build"
        },
        {
          "projects": [
            "@nexusdi/federation-engineering",
            "@nexusdi/federation-life-support"
          ],
          "target": "build"
        }
      ],
      "inputs": [
        "default",
        "^production",
        {
          "dependentTasksOutputFiles": "**/*"
        }
      ]
    },
    "e2e-growth": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build-e2e",
        "^build",
        {
          "projects": [
            "@nexusdi/federation-command",
            "@nexusdi/federation-engineering",
            "@nexusdi/federation-life-support"
          ],
          "target": "build"
        }
      ],
      "options": {
        "cwd": "examples/federation-shell",
        "command": "playwright test --config playwright.e2e-growth.config.mts"
      }
    }
  }
}
