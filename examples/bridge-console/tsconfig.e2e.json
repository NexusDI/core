{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": "out-tsc/playwright",
    "sourceMap": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "e2e/**/*.ts",
    "e2e/**/*.js",
    "playwright.config.mts",
    "playwright.e2e-growth.config.mts",
    "playwright.servers.mts"
  ],
  "exclude": [
    "out-tsc",
    "test-output",
    "eslint.config.js",
    "eslint.config.mjs",
    "eslint.config.cjs"
  ]
}
