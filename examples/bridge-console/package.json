{
  "name": "@nexusdi/bridge-console",
  "private": true,
  "type": "module",
  "dependencies": {
    "@nexusdi/core": "*",
    "@nexusdi/errors": "*",
    "@nexusdi/meridian-systems": "*",
    "@nexusdi/node": "*",
    "@nexusdi/react": "*",
    "@nexusdi/react-router": "*",
    "@react-router/node": "8.5.0",
    "@react-router/serve": "8.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.36",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.5",
    "@nexusdi/bridge-api": "*",
    "@nexusdi/devtools": "*",
    "@nexusdi/testing": "*",
    "@nexusdi/vitest": "*",
    "@nx/devkit": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/playwright": "23.3.0",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "8.5.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint-plugin-playwright": "^2.12.1",
    "tailwindcss": "^4.2.2"
  },
  "nx": {
    "tags": [
      "demo"
    ],
    "targets": {
      "typegen": {
        "cache": true,
        "inputs": [
          "{projectRoot}/app/**/*",
          "{projectRoot}/react-router.config.ts",
          "{projectRoot}/vite.config.ts"
        ],
        "outputs": [
          "{projectRoot}/.react-router"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "examples/bridge-console",
          "command": "react-router typegen"
        }
      },
      "typecheck": {
        "dependsOn": [
          "typegen",
          "^typecheck"
        ]
      },
      "e2e": {
        "dependsOn": [
          "build",
          "^build"
        ]
      },
      "e2e-growth": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "^build"
        ],
        "options": {
          "cwd": "examples/bridge-console",
          "command": "playwright test --config playwright.e2e-growth.config.mts"
        }
      }
    }
  }
}
