{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // rspack bundles the sources and resolves as a bundler does:
    // extensionless imports and a JSON module.
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    "rootDir": "src",
    "outDir": "out-tsc/app",
    "tsBuildInfoFile": "out-tsc/app/tsconfig.app.tsbuildinfo",
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [
    {
      "path": "../../libs/react/tsconfig.lib.json"
    },
    {
      "path": "../federation-contracts/tsconfig.lib.json"
    },
    {
      "path": "../../libs/core/tsconfig.lib.json"
    },
    {
      "path": "../../libs/testing/tsconfig.lib.json"
    },
    {
      "path": "../../libs/federation/tsconfig.lib.json"
    }
  ]
}
