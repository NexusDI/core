{
  "name": "@nexusdi/react-ssr",
  "private": true,
  "type": "module",
  "scripts": {},
  "sideEffects": false,
  "dependencies": {
    "@nexusdi/bridge-api": "*",
    "@nexusdi/core": "*",
    "@nexusdi/errors": "*",
    "@nexusdi/react": "*",
    "@nexusdi/react-router": "*",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@nexusdi/devtools": "*",
    "@nexusdi/testing": "*",
    "@nexusdi/vitest": "*",
    "@nx/eslint-plugin": "23.3.0",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "^4.1.10",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "^4.1.10"
  },
  "nx": {
    "targets": {
      "typegen": {
        "cache": true,
        "inputs": [
          "{projectRoot}/app/**/*",
          "{projectRoot}/react-router.config.ts",
          "{projectRoot}/vite.config.ts"
        ],
        "outputs": [
          "{projectRoot}/.react-router"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "examples/react-ssr",
          "command": "react-router typegen"
        }
      },
      "typecheck": {
        "dependsOn": [
          "typegen",
          "^typecheck"
        ]
      },
      "e2e": {
        "dependsOn": [
          "build",
          "^build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "examples/react-ssr",
          "command": "vitest run --config vitest.e2e.config.ts"
        }
      }
    }
  }
}
