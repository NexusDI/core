{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@nexusdi/bridge-api",
  "targets": {
    "dev-relay": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "examples/bridge-api",
        "command": "node --import tsx scripts/dev-relay.mjs"
      }
    },
    "dev": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "examples/bridge-api",
        "commands": [
          "node --import tsx scripts/dev-relay.mjs",
          "relay=http://127.0.0.1:${RELAY_PORT:-3100}; n=0; until curl -sf $relay/charts > /dev/null; do n=$((n+1)); if [ $n -ge 75 ]; then echo \"dev: no relay answered at $relay within 15 s; free the port or set RELAY_PORT\" >&2; exit 1; fi; sleep 0.2; done; RELAY_URL=$relay SHIP_INTROSPECTION=on tsx watch src/entries/server.hono.ts"
        ],
        "parallel": true
      }
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "e2e": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/bridge-api",
        "command": "vitest run --config vitest.e2e.config.ts"
      }
    },
    "e2e-growth": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/bridge-api",
        "commands": [
          "vitest run --config vitest.e2e-growth.config.ts",
          "vitest run --config vitest.workers-growth.config.ts",
          "node scripts/runtime-leg.mjs --leg=deno --entry=test/runtime/growth.ts",
          "node scripts/runtime-leg.mjs --leg=bun --entry=test/runtime/growth.ts"
        ],
        "parallel": false
      }
    },
    "graph": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/bridge-api",
        "command": "nexusdi graph src/ship/meridian.module.ts#Meridian --load src/ship/meridian.module.ts#FtlDrive --plugins src/ship/plugins.ts#graphPlugins -f json -o graph.json && git diff --exit-code graph.json"
      }
    },
    "profile": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/profile.json"],
      "options": {
        "cwd": "examples/bridge-api",
        "command": "node --import tsx scripts/dev-relay.mjs -- nexusdi profile src/ship/relay-meridian.ts#RelayMeridian --json profile.json"
      }
    },
    "bench": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/bridge-api",
        "command": "vitest bench --run && node bench/cold.mjs"
      }
    },
    "test-workers": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/bridge-api",
        "commands": [
          "wrangler types --config wrangler.jsonc --check",
          "vitest run --config vitest.workers.config.ts",
          "SIGNAL=off vitest run --config vitest.workers.config.ts"
        ],
        "parallel": false
      }
    },
    "runtime-leg": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/bridge-api",
        "command": "node scripts/runtime-leg.mjs --leg={args.leg}"
      }
    },
    "test-edge": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "examples/bridge-api",
        "command": "vitest run --config vitest.edge.config.ts"
      }
    }
  }
}
