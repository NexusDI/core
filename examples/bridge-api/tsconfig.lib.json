{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    // Vitest, wrangler and esbuild run the sources, so they resolve as a
    // bundler does: extensionless imports and a JSON module.
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["es2022", "esnext.disposable"],
    "types": ["node"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts", "src/**/*.json"],
  "references": [
    {
      "path": "../../libs/node/tsconfig.lib.json"
    },
    {
      "path": "../../libs/interceptors/tsconfig.lib.json"
    },
    {
      "path": "../../libs/hono/tsconfig.lib.json"
    },
    {
      "path": "../../libs/fastify/tsconfig.lib.json"
    },
    {
      "path": "../../libs/express/tsconfig.lib.json"
    },
    {
      "path": "../../libs/errors/tsconfig.lib.json"
    },
    {
      "path": "../../libs/devtools/tsconfig.lib.json"
    },
    {
      "path": "../../libs/core/tsconfig.lib.json"
    },
    {
      "path": "../../libs/vitest/tsconfig.lib.json"
    },
    {
      "path": "../../libs/testing/tsconfig.lib.json"
    },
    {
      "path": "../../libs/cli/tsconfig.lib.json"
    }
  ]
}
