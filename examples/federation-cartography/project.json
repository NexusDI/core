{
  "name": "@nexusdi/federation-cartography",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "examples/federation-cartography/src",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "rspack serve --mode=development",
        "cwd": "examples/federation-cartography"
      },
      "dependsOn": ["@nexusdi/federation-shell:serve"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rspack build --mode=production",
        "cwd": "examples/federation-cartography"
      },
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist/main"]
    },
    "build-drift": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist/drift"],
      "options": {
        "command": "rspack build --mode=production --config rspack.config.drift.ts",
        "cwd": "examples/federation-cartography"
      }
    },
    "build-unshared": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist/unshared"],
      "options": {
        "command": "rspack build --mode=production --config rspack.config.unshared.ts",
        "cwd": "examples/federation-cartography"
      }
    }
  }
}
