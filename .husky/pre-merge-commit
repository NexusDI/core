#!/usr/bin/env sh
# Refuse to write a merge commit, except on a sync/* branch.
#
# main and the X.Y.x maintenance lines are rebase-only, and GitHub cannot
# rebase-merge a branch whose history contains a merge commit. A branch
# assembled with `git merge` has to be rebuilt before it can land, and
# rebuilding means re-resolving every conflict already resolved once.
#
# A sync/X.Y-<sha> branch carries one merge of main into release/X.Y, and its
# pull request merges with a merge commit (RELEASING.md, "Branches"). That
# merge is the branch's whole purpose, so the hook lets it through.
#
# This fires only when a merge would create a commit. A fast-forward writes
# none and is untouched, so `git pull` on an unchanged branch still works.
#
# To collect work from another branch, replay it instead:
#
#   git cherry-pick <sha>...
#   git rebase --onto <here> <their-base> <their-branch>

case "$(git symbolic-ref --quiet --short HEAD)" in
  sync/*) exit 0 ;;
esac

cat >&2 <<'MESSAGE'

  A merge commit was refused.

  main and the X.Y.x lines are rebase-only, and GitHub will not rebase-merge a
  branch that contains a merge commit. Replay the work instead so the branch
  stays linear:

      git cherry-pick <sha>...
      git rebase --onto <here> <their-base> <their-branch>

  Syncing main into a release/X.Y line: do it on a sync/X.Y-<sha> branch
  (RELEASING.md, "Branches").

MESSAGE

exit 1
