{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "vitest/globals"],
    "outDir": "dist",
    // Node 24 runs the harness without a build: it strips erasable types
    // only, and it resolves sibling imports by their .ts names.
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../tools/bench-kit"
    }
  ]
}
