{
  "name": "@nexusdi/benchmarks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@nexusdi/bench-kit": "*",
    "@nexusdi/toolchain-matrix": "*",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "esbuild": "0.28.2",
    "rollup": "4.64.7",
    "tslib": "2.8.1",
    "yaml": "^2.9.1"
  },
  "nx": {
    "targets": {
      "matrix": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "benchmarks",
          "command": "node src/matrix.ts"
        }
      },
      "probes": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "benchmarks",
          "command": "node src/probes.ts"
        }
      },
      "size": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "benchmarks",
          "command": "node src/size.ts"
        }
      },
      "build-times": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "benchmarks",
          "command": "node src/build.ts"
        }
      },
      "timings": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "benchmarks",
          "command": "node src/timings/orchestrator.ts"
        }
      },
      "scale": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "benchmarks",
          "command": "node src/scale/deterministic.ts"
        }
      },
      "scale-timings": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "benchmarks",
          "command": "node src/scale/timings.ts"
        }
      },
      "scale-render": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "benchmarks",
          "command": "node src/scale/render.ts"
        }
      },
      "check": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "benchmarks",
          "parallel": false,
          "commands": [
            "node src/matrix.ts --check",
            "node src/probes.ts --check",
            "node src/size.ts --check",
            "node src/scale/deterministic.ts --check",
            "node src/scale/render.ts --check",
            "node src/scale/timings.ts --quick --sizes=50 --shapes=mixed",
            "vitest run --config vite.config.ts src/matrix-consistency.test.ts",
            "vitest run --config vitest.cells.config.ts"
          ]
        }
      },
      "bench": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "benchmarks",
          "parallel": false,
          "commands": [
            "node src/matrix.ts",
            "node src/probes.ts",
            "node src/size.ts",
            "node src/build.ts",
            "node src/timings/orchestrator.ts",
            "node src/scale/deterministic.ts",
            "node src/scale/timings.ts",
            "node src/scale/render.ts"
          ]
        }
      }
    }
  }
}
