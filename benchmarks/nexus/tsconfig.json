{
  // This is a per-benchmark tsconfig.json. Adjust paths as needed for your DI container and the benchmark plugin.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@nexusdi/benchmark": ["../../../tools/benchmark/src/index.ts"],
      "@nexusdi/core": ["../../../node_modules/@nexusdi/core"]
      // Add a path for your DI container here if it's local
    }
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../libs/core"
    },
    {
      "path": "../../tools/benchmark"
    }
  ]
}
