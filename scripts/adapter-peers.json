{
  "hono-floor": {
    "install": ["hono@4.3.3", "@hono/node-server@1.19.17"],
    "targets": ["@nexusdi/hono:test"]
  },
  "hono-latest": {
    "install": ["hono@^4"],
    "targets": ["@nexusdi/hono:test"]
  },
  "express-floor": {
    "install": ["express@5.0.0"],
    "targets": ["@nexusdi/express:test"],
    "legacyPeerDeps": true
  },
  "express-latest": {
    "install": ["express@^5"],
    "targets": ["@nexusdi/express:test"],
    "legacyPeerDeps": true
  },
  "fastify-floor": {
    "install": ["fastify@5.0.0", "fastify-plugin@6.0.0"],
    "targets": ["@nexusdi/fastify:test"]
  },
  "fastify-latest": {
    "install": ["fastify@^5", "fastify-plugin@^6"],
    "targets": ["@nexusdi/fastify:test"]
  },
  "react-router-7-floor": {
    "families": [
      {
        "packages": [
          "react-router",
          "@react-router/node",
          "@react-router/serve",
          "@react-router/dev"
        ],
        "version": "7.9.0"
      }
    ],
    "env": {
      "REACT_ROUTER_V8_MIDDLEWARE": "1"
    },
    "targets": ["@nexusdi/react-router:test"],
    "legacyPeerDeps": true,
    "peerExceptions": {
      "@react-router/dev": {
        "vite": "vitest 5 needs vite 8; vite is the fixture app's build tool, and the adapter never loads it"
      }
    }
  },
  "react-router-7-latest": {
    "families": [
      {
        "packages": [
          "react-router",
          "@react-router/node",
          "@react-router/serve",
          "@react-router/dev"
        ],
        "version": "^7"
      }
    ],
    "env": {
      "REACT_ROUTER_V8_MIDDLEWARE": "1"
    },
    "targets": ["@nexusdi/react-router:test"],
    "legacyPeerDeps": true
  },
  "react-router-8-latest": {
    "families": [
      {
        "packages": [
          "react-router",
          "@react-router/node",
          "@react-router/serve",
          "@react-router/dev"
        ],
        "version": "^8"
      }
    ],
    "targets": ["@nexusdi/react-router:test"],
    "legacyPeerDeps": true
  },
  "react-floor": {
    "install": [
      "react@19.0.0",
      "react-dom@19.0.0",
      "@types/react@19.0.0",
      "@types/react-dom@19.0.0"
    ],
    "browsers": true,
    "targets": ["@nexusdi/react:test", "@nexusdi/react:e2e-hmr"]
  },
  "react-19-latest": {
    "install": [
      "react@^19",
      "react-dom@^19",
      "@types/react@^19",
      "@types/react-dom@^19"
    ],
    "browsers": true,
    "targets": ["@nexusdi/react:test", "@nexusdi/react:e2e"]
  },
  "vitest-floor": {
    "install": ["vitest@4.1.0"],
    "targets": ["@nexusdi/vitest:test"],
    "legacyPeerDeps": true
  },
  "vitest-4-latest": {
    "install": ["vitest@^4"],
    "targets": ["@nexusdi/vitest:test"],
    "legacyPeerDeps": true
  },
  "vitest-5-latest": {
    "install": ["vitest@^5"],
    "targets": ["@nexusdi/vitest:test"],
    "legacyPeerDeps": true
  }
}
