{
  "hono-floor": {
    "install": ["hono@4.3.3", "@hono/node-server@1.19.17"],
    "targets": ["@nexusdi/hono:test"]
  },
  "hono-latest": {
    "install": ["hono@^4"],
    "targets": ["@nexusdi/hono:test"]
  },
  "express-floor": {
    "install": ["express@5.0.0"],
    "targets": ["@nexusdi/express:test"],
    "legacyPeerDeps": true
  },
  "express-latest": {
    "install": ["express@^5"],
    "targets": ["@nexusdi/express:test"],
    "legacyPeerDeps": true
  },
  "fastify-floor": {
    "install": ["fastify@5.0.0", "fastify-plugin@6.0.0"],
    "targets": ["@nexusdi/fastify:test"]
  },
  "fastify-latest": {
    "install": ["fastify@^5", "fastify-plugin@^6"],
    "targets": ["@nexusdi/fastify:test"]
  },
  "react-router-7-floor": {
    "install": [
      "react-router@7.9.0",
      "@react-router/node@7.9.0",
      "@react-router/serve@7.9.0",
      "@react-router/dev@7.9.0"
    ],
    "env": {
      "REACT_ROUTER_V8_MIDDLEWARE": "1"
    },
    "targets": ["@nexusdi/react-router:test"],
    "legacyPeerDeps": true
  },
  "react-router-7-latest": {
    "install": [
      "react-router@^7",
      "@react-router/node@^7",
      "@react-router/serve@^7",
      "@react-router/dev@^7"
    ],
    "env": {
      "REACT_ROUTER_V8_MIDDLEWARE": "1"
    },
    "targets": ["@nexusdi/react-router:test"],
    "legacyPeerDeps": true
  },
  "react-router-8-latest": {
    "install": [
      "react-router@^8",
      "@react-router/node@^8",
      "@react-router/serve@^8",
      "@react-router/dev@^8"
    ],
    "targets": ["@nexusdi/react-router:test"]
  },
  "react-floor": {
    "install": [
      "react@19.0.0",
      "react-dom@19.0.0",
      "@types/react@19.0.0",
      "@types/react-dom@19.0.0"
    ],
    "browsers": true,
    "targets": ["@nexusdi/react:test", "@nexusdi/react:e2e-hmr"]
  },
  "react-19-latest": {
    "install": [
      "react@^19",
      "react-dom@^19",
      "@types/react@^19",
      "@types/react-dom@^19"
    ],
    "browsers": true,
    "targets": ["@nexusdi/react:test", "@nexusdi/react:e2e"]
  },
  "vitest-floor": {
    "install": ["vitest@4.1.0"],
    "targets": ["@nexusdi/vitest:test"],
    "legacyPeerDeps": true
  },
  "vitest-4-latest": {
    "install": ["vitest@^4"],
    "targets": ["@nexusdi/vitest:test"],
    "legacyPeerDeps": true
  },
  "vitest-5-latest": {
    "install": ["vitest@^5"],
    "targets": ["@nexusdi/vitest:test"],
    "legacyPeerDeps": true
  }
}
