{
  "name": "@nexusdi/core",
  "version": "0.3.2",
  "description": "A compiled, sealed dependency injection container for TypeScript: typed provide() definitions, module encapsulation, scopes and ordered shutdown.",
  "keywords": [
    "dependency injection",
    "di",
    "inversion of control",
    "ioc",
    "typescript",
    "decorators",
    "service container",
    "dependency injection container",
    "nodejs",
    "javascript",
    "modular",
    "lightweight",
    "provider",
    "service",
    "module"
  ],
  "homepage": "https://github.com/NexusDI/core#readme",
  "bugs": {
    "url": "https://github.com/NexusDI/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusDI/core.git",
    "directory": "libs/core"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/polyfill/symbol-metadata.ts",
    "./dist/polyfill/symbol-metadata.js",
    "./src/polyfill/symbol-dispose.ts",
    "./dist/polyfill/symbol-dispose.js"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nexusdi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "@nexusdi/source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./testing": {
      "@nexusdi/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.test-d.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
