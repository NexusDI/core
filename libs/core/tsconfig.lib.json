{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "experimentalDecorators": true,
    // Legacy decorators are the one construct at target es2022 that still
    // emits a tslib helper, so this package turns importHelpers back on
    // next to experimentalDecorators and declares tslib as a runtime
    // dependency in package.json (never devDependencies) to match.
    "importHelpers": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "lib": ["es2022", "esnext.decorators"],
    "sourceMap": false,
    "declarationMap": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts"],
  "references": [],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ]
}
