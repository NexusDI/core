{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    // importHelpers stays off (the tsconfig.base.json default). Core's source
    // applies no decorator and declares no `using`, so tsc emits no helper
    // that would import tslib. scripts/verify-packaging.mjs checks the packed
    // output for that, and tools/repo-checks/src/tslib-dependency.test.ts
    // holds the setting against package.json.
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    // esnext.disposable types Symbol.asyncDispose and AsyncDisposable, which
    // the public declarations use. esnext.decorators types Symbol.metadata.
    "lib": ["es2022", "esnext.decorators", "esnext.disposable"],
    "sourceMap": false,
    "declarationMap": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../tools/doc-examples"
    }
  ],
  "exclude": [
    "vite.config.ts",
    "vitest.browser.config.ts",
    "vite.decorators.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test-d.ts"
  ]
}
