{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@nexusdi/core",
  "targets": {
    "test-browser": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "cwd": "libs/core",
        "command": "vitest run --config vitest.browser.config.ts"
      }
    },
    "test-bench": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default"],
      "options": {
        "cwd": "libs/core",
        "command": "vitest run --config bench/vitest.config.ts"
      }
    },
    "bench-dispatch": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "libs/core",
        "command": "node bench/run.mjs"
      }
    },
    "test": {
      "dependsOn": ["^build", "build", "test-browser", "test-bench"]
    },
    "lint": {
      "options": {
        "args": ["--max-warnings=0"]
      }
    }
  }
}
