{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "esnext.decorators", "esnext.disposable"],
    "types": ["node"],
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true
  },
  "include": ["src/**/*.ts", "test-support/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
