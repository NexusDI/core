{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    // importHelpers stays off (the tsconfig.base.json default). The CLI
    // applies no decorator and declares no `using`, so tsc emits no helper
    // that would import tslib.
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "lib": ["es2022"],
    "sourceMap": false,
    "declarationMap": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../devtools/tsconfig.lib.json"
    },
    {
      "path": "../core/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vite.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test-d.ts"
  ]
}
