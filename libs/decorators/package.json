{
  "name": "@nexusdi/decorators",
  "version": "0.4.0-rc.0",
  "description": "NestJS-style @Injectable, @Inject and @Module for NexusDI, with standard decorators and no compiler flags.",
  "keywords": [
    "nexusdi",
    "dependency injection",
    "decorators",
    "standard decorators",
    "tc39",
    "injectable",
    "nestjs",
    "typescript"
  ],
  "homepage": "https://github.com/NexusDI/core#readme",
  "bugs": {
    "url": "https://github.com/NexusDI/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusDI/core.git",
    "directory": "libs/decorators"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/polyfill/symbol-metadata.ts",
    "./dist/polyfill/symbol-metadata.js"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nexusdi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.test-d.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@nexusdi/core": "0.4.0-rc.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
