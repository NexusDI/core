{
  "name": "@nexusdi/decorators",
  "version": "0.3.2",
  "description": "Standard decorators for NexusDI: @Injectable, @Inject and @Module.",
  "keywords": [
    "dependency injection",
    "di",
    "nexusdi",
    "typescript",
    "decorators"
  ],
  "homepage": "https://github.com/NexusDI/core#readme",
  "bugs": {
    "url": "https://github.com/NexusDI/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusDI/core.git",
    "directory": "libs/decorators"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/polyfill/symbol-metadata.ts",
    "./dist/polyfill/symbol-metadata.js"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nexusdi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.test-d.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@nexusdi/core": "0.3.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
