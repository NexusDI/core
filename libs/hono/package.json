{
  "name": "@nexusdi/hono",
  "version": "0.4.0-rc.1",
  "description": "Scope every Hono request with NexusDI, on Node, Workers, Deno and Bun.",
  "keywords": [
    "nexusdi",
    "dependency injection",
    "hono",
    "hono-middleware",
    "cloudflare-workers",
    "typescript"
  ],
  "homepage": "https://github.com/NexusDI/core#readme",
  "bugs": {
    "url": "https://github.com/NexusDI/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusDI/core.git",
    "directory": "libs/hono"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nexusdi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.test-d.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@nexusdi/core": "0.4.0-rc.1",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "hono": "^4.13.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
