{
  "name": "@nexusdi/federation",
  "version": "0.4.0-rc.0",
  "description": "Unify dependency singleton instances across micro-frontend shells and remotes.",
  "keywords": [
    "nexusdi",
    "dependency injection",
    "micro-frontends",
    "module federation",
    "contracts",
    "versioning",
    "typescript"
  ],
  "homepage": "https://github.com/NexusDI/core#readme",
  "bugs": {
    "url": "https://github.com/NexusDI/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusDI/core.git",
    "directory": "libs/federation"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nexusdi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./text": {
      "@nexusdi/source": "./src/text.ts",
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js",
      "default": "./dist/text.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.test-d.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@nexusdi/core": "0.4.0-rc.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
