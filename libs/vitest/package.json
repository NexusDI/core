{
  "name": "@nexusdi/vitest",
  "version": "0.4.0-rc.1",
  "description": "Get a NexusDI testing container and scope in every Vitest test, disposed after it.",
  "keywords": [
    "nexusdi",
    "dependency injection",
    "vitest",
    "fixtures",
    "testing",
    "typescript"
  ],
  "homepage": "https://github.com/NexusDI/core#readme",
  "bugs": {
    "url": "https://github.com/NexusDI/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusDI/core.git",
    "directory": "libs/vitest"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nexusdi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.test-d.*",
    "!src/**/__fixtures__/**",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@nexusdi/core": "0.4.0-rc.1",
    "@nexusdi/testing": "0.4.0-rc.1",
    "vitest": "^4.1.0 || ^5.0.0",
    "@vitest/runner": "^4.1.0 || ^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
