{
  // tsconfig.spec.json without src/fixtures.test-d.ts, for a run on Vitest 5
  // (vite.config.ts picks it). extends carries no references, so they repeat.
  "extends": "./tsconfig.spec.json",
  "exclude": ["src/fixtures.test-d.ts"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
