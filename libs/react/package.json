{
  "name": "@nexusdi/react",
  "version": "0.4.0-rc.2",
  "description": "Give React components the services of a NexusDI container.",
  "keywords": [
    "nexusdi",
    "dependency injection",
    "react",
    "hooks",
    "typescript"
  ],
  "homepage": "https://github.com/NexusDI/core#readme",
  "bugs": {
    "url": "https://github.com/NexusDI/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusDI/core.git",
    "directory": "libs/react"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nexusdi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.test-d.*",
    "!src/**/__fixtures__/**",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@nexusdi/core": "0.4.0-rc.2",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.0",
    "@react-router/node": "^8.5.1",
    "@testing-library/react": "16.3.3",
    "isbot": "^5.2.2",
    "jsdom": "30.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "^8.5.1",
    "vite": "8.3.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
