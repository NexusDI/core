{
  "name": "@nexusdi/react-router",
  "version": "0.4.0-rc.1",
  "description": "Scope every React Router request with NexusDI, from middleware to loaders.",
  "keywords": [
    "nexusdi",
    "dependency injection",
    "react-router",
    "middleware",
    "ssr",
    "typescript"
  ],
  "homepage": "https://github.com/NexusDI/core#readme",
  "bugs": {
    "url": "https://github.com/NexusDI/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusDI/core.git",
    "directory": "libs/react-router"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nexusdi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.test-d.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@nexusdi/core": "0.4.0-rc.1",
    "react-router": "^7.9.0 || ^8.0.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "isbot": "^5.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^8.4.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
