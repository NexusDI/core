{
  "name": "@nexusdi/devtools",
  "version": "0.4.0-rc.1",
  "description": "Gain total visibility into your dependency graph and container lifecycle.",
  "keywords": [
    "nexusdi",
    "dependency injection",
    "dependency graph",
    "devtools",
    "mermaid",
    "graphviz",
    "tracing",
    "typescript"
  ],
  "homepage": "https://github.com/NexusDI/core#readme",
  "bugs": {
    "url": "https://github.com/NexusDI/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusDI/core.git",
    "directory": "libs/devtools"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nexusdi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.test-d.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@nexusdi/errors": "0.4.0-rc.1"
  },
  "peerDependencies": {
    "@nexusdi/core": "0.4.0-rc.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "mermaid": "^11.17.2"
  }
}
