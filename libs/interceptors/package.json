{
  "name": "@nexusdi/interceptors",
  "version": "0.4.0-rc.1",
  "description": "Decouple cross-cutting concerns from your business logic using transparent method wrappers.",
  "keywords": [
    "nexusdi",
    "dependency injection",
    "interceptors",
    "aop",
    "middleware",
    "logging",
    "metrics",
    "typescript"
  ],
  "homepage": "https://github.com/NexusDI/core#readme",
  "bugs": {
    "url": "https://github.com/NexusDI/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusDI/core.git",
    "directory": "libs/interceptors"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/polyfill/symbol-metadata.ts",
    "./dist/polyfill/symbol-metadata.js"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nexusdi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./text": {
      "@nexusdi/source": "./src/text.ts",
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js",
      "default": "./dist/text.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.test-d.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@nexusdi/core": "0.4.0-rc.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
