{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "meridian-ship",
  "targets": {
    "check-schematic": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node tools/meridian-ship/check-schematic.mjs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tools/meridian-ship"
      }
    }
  }
}
