{
  "name": "@nexusdi/repo-checks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@nexusdi/doc-examples": "*",
    "@nexusdi/release": "*",
    "@nx/devkit": "23.3.0",
    "jsonc-parser": "^3.3.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "twoslash": "0.3.9",
    "typescript": "6.0.3",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "nx": {
    "targets": {
      "test": {
        "dependsOn": [
          "^build",
          {
            "projects": [
              "libs/*"
            ],
            "target": "build"
          },
          {
            "projects": [
              "@nexusdi/docs"
            ],
            "target": "behaviour-data"
          },
          {
            "projects": [
              "libs/*"
            ],
            "target": "test"
          }
        ],
        "inputs": [
          "default",
          "repoChecks",
          "^production",
          {
            "runtime": "git ls-files -s .husky/_"
          }
        ]
      }
    }
  }
}
